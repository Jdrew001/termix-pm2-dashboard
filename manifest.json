{
  "id": "pm2-dashboard",
  "name": "PM2 Dashboard",
  "version": "1.7.0",
  "description": "A dedicated PM2 menu with application metrics across your servers.",
  "author": {
    "name": "Abide Studios"
  },
  "license": "Apache-2.0",
  "category": "Monitoring",
  "icon": "Activity",
  "features": [
    "Dedicated PM2 menu with automatic metrics",
    "Clickable app details with process owner and status",
    "Live regular, error and combined logs",
    "Search, pause, auto-scroll and bounded log history"
  ],
  "engine": {
    "termix": ">=26.11.1",
    "api": "^1.17"
  },
  "capabilities": ["network:serve", "ui:surface", "operations:invoke"],
  "env": [],
  "dependencies": {
    "process-manager": "^1.0.0"
  },
  "contributes": {
    "tabs": [
      {
        "id": "pm2-dashboard",
        "titleKey": "tab.title",
        "icon": "Activity",
        "openFrom": ["rail", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "operations": {
      "invokes": [
        "process-manager.list-apps",
        "process-manager.list-processes",
        "process-manager.tail-logs"
      ]
    },
    "settings": {
      "user": [
        {
          "key": "abideAutomaticUpdates",
          "type": "boolean",
          "labelKey": "settings.abide.label",
          "descriptionKey": "settings.abide.description",
          "default": false
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["darwin", "linux", "win32"],
  "repository": "https://github.com/Jdrew001/termix-pm2-dashboard",
  "docs": "https://github.com/Jdrew001/termix-pm2-dashboard/blob/main/docs/index.md"
}
